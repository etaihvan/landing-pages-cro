<section class="final ruled" id="demo">
  <img class="coin" src="https://spade.com/_next/image/?url=%2Fcoin.png&w=480&q=75" alt="" aria-hidden="true" onerror="this.remove();document.querySelector('.final .glyph').style.display='block'">
  <svg class="glyph" style="display:none" viewBox="0 0 100 100" fill="none" stroke="#b9ea6c" stroke-width=".8" aria-hidden="true">
    <ellipse cx="50" cy="50" rx="34" ry="40"/><ellipse cx="50" cy="50" rx="26" ry="40"/><ellipse cx="50" cy="50" rx="16" ry="40"/><ellipse cx="50" cy="50" rx="6" ry="40"/>
    <path d="M16 36h68M14 50h72M16 64h68M22 24h56M22 76h56"/>
  </svg>
  <div class="wrap final-grid">
    <div>
      <h2>Get a demo with our <em>enrichment team</em></h2>
      <p>30 minutes, on the transactions you care about.</p>
      <div class="assure">No PII needed · SOC 2 Type 2</div>
    </div>
    <div class="form-card lead-card full-form" id="final-form-card" data-card="final">
        <div class="lstep active" data-step="contact">
          <div class="hs-slot"></div>
        </div>
        <div class="lstep" data-step="done">
          <div class="booked">
            <div class="tick">✓</div>
            <h3 data-done-title>Thanks. Your scheduler is opening.</h3>
            <p data-done-body style="margin:0;font-size:14px;color:var(--ink-2)">Pick a time with our enrichment team in the window that just opened.</p>
          </div>
        </div>
      </div>
  </div>
</section>
